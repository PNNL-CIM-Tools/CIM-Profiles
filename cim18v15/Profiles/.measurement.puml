' CommunicationLink inherits from PowerSystemResource
class CommunicationLink <<ShadowExtension>>  {
   +<<GridAPPSD>> communicationMediumKind: CommunicationMediumKind [0..1]
   +<<GridAPPSD>> communicationProtocolType: CommunicationProtocolKind [0..1]
}

PowerSystemResource <|-- CommunicationLink

CommunicationLink "+CommunicationLink 0..*" --> "+BilateralExchangeActor 0..1" BilateralExchangeActor
CommunicationLink "+CommunicationLinks 0..*" --> "+RemoteUnits 0..*" RemoteUnit

enum CommunicationMediumKind <<GridAPPSD>><<enumeration>><<Attribute>>  {
   cellular2G
   cellular3G
   cellular5G
   cellularLTE
   fiber
   microwave
   radio
}

enum CommunicationProtocolKind <<GridAPPSD>><<enumeration>><<Attribute>>  {
   dnp3
   iccp
   iec61850
   ieee2030_5
   ieee2664
   ieeeC37_118
   modbus
   sunspecModbus
}

