PowerSystemResource <|-- TapChanger


' TransformerCore inherits from MagneticCore
class TransformerCore <<GridAPPSD>><<new>>  {
   +b: Susceptance [0..1]
   +form: CoreConstructionKind [0..1]
   +g: Conductance [0..1]
}

MagneticCore <|-- TransformerCore


