IdentifiedObject <|-- TransformerWinding


' WireConfiguration inherits from IdentifiedObject
class WireConfiguration <<GridAPPSD>>  {
   +<<GridAPPSD>> installationType: WireInstallationKind [0..1]
   +numberOfPhases: Integer [0..1]
   +usage: WireUsageKind [0..1]
}

IdentifiedObject <|-- WireConfiguration

WireConfiguration "+WireAssemblies 0..*" --> "+EarthResistivity 0..1" EarthResistivity : <<GridAPPSD>>
WireConfiguration "+WireAssembly 0..1" --> "+PerLengthImpedance 0..1" PerLengthImpedance

enum WireInstallationKind <<GridAPPSD>><<enumeration>>  {
   overheadBare
   overheadSpacerCable
   overheadTreeWire
   undergroundConduit
   undergroundDirectBury
   undergroundDuctBank
}

enum WireUsageKind <<enumeration>>  {
   distribution
   other
   secondary
   transmission
}

@enduml
