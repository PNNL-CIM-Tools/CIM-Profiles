' RotatingMachine inherits from RegulatingCondEq
abstract class RotatingMachine <<ShadowExtension>><<GridAPPSD>> <<abstract>> {
   +ratedPowerFactor: Float [0..1]
   +ratedS: ApparentPower [0..1]
   +ratedU: Voltage [0..1]
}

RegulatingCondEq <|-- RotatingMachine

RotatingMachine "+RotatingMachine 0..*" --> "+GeneratingUnit 0..1" GeneratingUnit#red

' SeriesCompensator inherits from ConductingEquipment
class SeriesCompensator <<ShadowExtension>><<Description>>  {
   +r: Resistance [0..1]
   +varistorPresent: Boolean [0..1]
   +varistorRatedCurrent: CurrentFlow [0..1]
   +varistorVoltageThreshold: Voltage [0..1]
   +x: Reactance [0..1]
}

ConductingEquipment <|-- SeriesCompensator


' ServiceDisconnect inherits from ConductingEquipment
class ServiceDisconnect <<GridAPPSD>><<Description>>  {
}

ConductingEquipment <|-- ServiceDisconnect


' ShuntCompensator inherits from RegulatingCondEq
abstract class ShuntCompensator <<ShadowExtension>><<GridAPPSD>> <<abstract>> {
   +maximumSections: Integer [0..1]
   +nomQ: ReactivePower [0..1]
   +nomU: Voltage [0..1]
   +normalSections: Integer [0..1]
   +voltageSensitivity: VoltagePerReactivePower [0..1]
}

RegulatingCondEq <|-- ShuntCompensator


' ShuntCompensatorPhase inherits from PowerSystemResource
abstract class ShuntCompensatorPhase <<GridAPPSD>><<ShadowExtension>> <<abstract>> {
   +maximumSections: Integer [0..1]
   +nomQ: ReactivePower [0..1]
   +normalSections: Integer [0..1]
}

PowerSystemResource <|-- ShuntCompensatorPhase

ShuntCompensatorPhase "+ShuntCompensatorPhase 0..*" --> "+ShuntCompensator 0..1" ShuntCompensator#red : <<ShadowExtension>>

enum SinglePhaseKind <<ShadowExtension>><<enumeration>><<Attribute>>  {
   A
   B
   C
   E
   N
   X
   Y
   s1
   s2
}

' SynchronousMachine inherits from RotatingMachine
class SynchronousMachine   {
