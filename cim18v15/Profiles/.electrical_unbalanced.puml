   +minQ: ReactivePower [0..1]
}

RotatingMachine <|-- SynchronousMachine


' TapChanger inherits from PowerSystemResource
abstract class TapChanger <<ShadowExtension>><<gmdm>> <<abstract>> {
   +highStep: Integer [0..1]
   +lowStep: Integer [0..1]
   +normalStep: Integer [0..1]
   +step: Float [0..1]
}

PowerSystemResource <|-- TapChanger


' TranformerImpedanceMatrix
class TranformerImpedanceMatrix <<GridAPPSD>>  {
}

TranformerImpedanceMatrix "+TransformerImpedanceMatrix 0..1" --> "+PowerTransformer 0..1" PowerTransformer : <<ShadowExtension>>

' TransformerCore inherits from MagneticCore
class TransformerCore <<Description>><<GridAPPSD>><<new>>  {
   +b: Susceptance [0..1]
   +form: CoreConstructionKind [0..1]
   +g: Conductance [0..1]
}

MagneticCore <|-- TransformerCore

TransformerCore "+TransformerCore 0..1" --> "+TransformerTank 0..1" TransformerTank : <<ShadowExtension>>

