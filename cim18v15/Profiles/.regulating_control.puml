top to bottom direction
hide empty methods

' Adjust the horizontal spacing for better spatial rendering (the PlantUML default is ~20)
skinparam nodesep 20
' Adjust the vertical spacing for better spatial rendering (the PlantUML default is ~30)
skinparam ranksep 30

skinparam BackgroundColor #FFFFFF
skinparam shadowing false
skinparam RoundCorner 5
skinparam BorderColor #454645
skinparam ArrowColor #454645
skinparam FontColor #000000

skinparam class {
  ' Document root element style definition
  BackgroundColor<<Document Root>> #D3FBFE
  FontColor<<Document Root>> #000000
  FontSize<<Document Root>> 18
  AttributeFontColor<<Document Root>> #000000
  AttributeFontSize<<Document Root>> 18
  StereotypeFontColor<<Document Root>> #000000
  StereotypeFontSize<<Document Root>> 14
  HeaderFontColor<<Document Root>> #000000
  
  ' Choice element style definition
  BackgroundColor<<Choice>> #E6E6FF
  FontColor<<Choice>> #000000
  AttributeFontColor<<Choice>> #000000
  StereotypeFontColor<<Choice>> #000000
  HeaderFontColor<<Choice>> #000000
  BorderColor<<Choice>> #454645
  BorderThickness<<Choice>> 1
  
  ' Ref element style definition
  BackgroundColor<<Ref>> #FFDBDB
  FontColor<<Ref>> #000000
  AttributeFontColor<<Ref>> #000000
  StereotypeFontColor<<Ref>> #000000
  HeaderFontColor<<Ref>> #000000
  BorderColor<<Ref>> #454645
  BorderThickness<<Ref>> 1
  
  ' Concrete classes style definition
  BackgroundColor #FFFFE0
  FontColor #000000
  AttributeFontColor #000000
  StereotypeFontColor #000000
  HeaderFontColor #000000
  BorderColor #454645
  BorderThickness 1
  
  ' Abstract classes style definition
  BackgroundColor<<abstract>> #E8E8E8
  FontColor<<abstract>> #000000
  AttributeFontColor<<abstract>> #000000
  StereotypeFontColor<<abstract>> #000000
  HeaderFontColor<<abstract>> #000000
  BorderColor<<abstract>> #454645
  BorderThickness<<abstract>> 1
  
  ' Enumerations style definition
  BackgroundColor<<enumeration>> #A9F1A9
  FontColor<<enumeration>> #000000
  AttributeFontColor<<enumeration>> #000000
  StereotypeFontColor<<enumeration>> #000000
  HeaderFontColor <<enumeration>> #000000
  BorderColor<<enumeration>> #454645
  BorderThickness<<enumeration>> 1
  
  ' CIMDatatypes style definition
  BackgroundColor<<CIMDatatype>> #FFEBCD
  FontColor<<CIMDatatype>> #000000
  AttributeFontColor<<CIMDatatype>> #000000
  StereotypeFontColor<<CIMDatatype>> #000000
  HeaderFontColor<<CIMDatatype>> #000000
  BorderColor<<CIMDatatype>> #454645
  BorderThickness<<CIMDatatype>> 1
  
  ' Compound classes style definition
  BackgroundColor<<Compound>> #FFEBCD
  FontColor<<Compound>> #000000
  AttributeFontColor<<Compound>> #000000
  StereotypeFontColor<<Compound>> #000000
  HeaderFontColor<<Compound>> #000000
  BorderColor<<Compound>> #454645
  BorderThickness<<Compound>> 1
  
  ' Primitive classes style definition
  BackgroundColor<<Primitive>> #E6E6FF
  FontColor<<Primitive>> #000000
  AttributeFontColor<<Primitive>> #000000
  StereotypeFontColor<<Primitive>> #000000
  HeaderFontColor<<Primitive>> #000000
  BorderColor<<Primitive>> #454645
  BorderThickness<<Primitive>> 1
  
  ' Errors classes style definition
  BackgroundColor<<error>> #FFC0CB
  FontColor<<error>> #000000
  AttributeFontColor<<error>> #000000
  StereotypeFontColor<<error>> #000000
  HeaderFontColor<<error>> #000000
  BorderColor<<error>> #454645
  BorderThickness<<error>> 1
  
  ' Shadow classes style definition
  BackgroundColor<<ShadowExtension>> #C0C0C0
  FontColor<<ShadowExtension>> #000000
  AttributeFontColor<<ShadowExtension>> #000000
  StereotypeFontColor<<ShadowExtension>> #000000
  HeaderFontColor<<ShadowExtension>> #000000
  BorderColor<<ShadowExtension>> #454645
  BorderThickness<<ShadowExtension>> 1
  
}

skinparam shadowing true

hide <<Document Root>> stereotype
hide <<Choice>> stereotype
hide <<Ref>> stereotype
hide <<abstract>> stereotype
hide <<error>> stereotype


skinparam note {
   BorderColor #454645
   BorderThickness 1
   FontSize 14
   Font Bold
   FontColor #000000
}

' Add a note towards the upper left corner of the diagram
note as tier5_protectionNote #lightyellow
   Profile: tier5_protection
   Namespace: http://www.gridappsd.org/vfm#
end note

' ACDCTerminal inherits from IdentifiedObject
abstract class ACDCTerminal  <<abstract>> {
}

IdentifiedObject <|-- ACDCTerminal


' AutomationFunction inherits from PowerSystemResource
abstract class AutomationFunction  <<abstract>> {
   +enabled: Boolean [0..1]
   +normalEnabled: Boolean [0..1]
   +type: String [0..1]
}

PowerSystemResource <|-- AutomationFunction


' ConductingEquipment inherits from Equipment
abstract class ConductingEquipment <<ShadowExtension>> <<abstract>> {
}

Equipment <|-- ConductingEquipment


' EnergyConnection inherits from ConductingEquipment
abstract class EnergyConnection  <<abstract>> {
}

ConductingEquipment <|-- EnergyConnection


' Equipment inherits from PowerSystemResource
abstract class Equipment  <<abstract>> {
}

PowerSystemResource <|-- Equipment


' EquipmentController inherits from AutomationFunction
abstract class EquipmentController  <<abstract>> {
}

AutomationFunction <|-- EquipmentController


' IdentifiedObject
abstract class IdentifiedObject  <<abstract>> {
   +mRID: String [0..1]
   +description: String [0..1]
   +name: String [0..1]
}


' LinearShuntCompensator inherits from ShuntCompensator
class LinearShuntCompensator <<Description>>  {
}

ShuntCompensator <|-- LinearShuntCompensator


enum PhaseCode <<enumeration>><<Attribute>>  {
   A
   AB
   ABC
   ABCN
   ABN
   AC
   ACN
   AN
   B
   BC
   BCN
   BN
   C
   CN
   N
   X
   XN
   XY
   XYN
   none
   [Remaining 6 literals hidden]
}

' PhaseTapChanger inherits from TapChanger
class PhaseTapChanger   {
}

TapChanger <|-- PhaseTapChanger

PhaseTapChanger "+PhaseTapChanger 0..1" --> "+TransformerEnd 0..1" TransformerEnd

' PowerSystemResource inherits from IdentifiedObject
abstract class PowerSystemResource <<ShadowExtension>> <<abstract>> {
}

IdentifiedObject <|-- PowerSystemResource


' PowerTransformerEnd inherits from TransformerEnd
class PowerTransformerEnd <<ShadowExtension>><<Description>>  {
}

TransformerEnd <|-- PowerTransformerEnd


' RatioTapChanger inherits from TapChanger
class RatioTapChanger   {
   +stepVoltageIncrement: PerCent [0..1]
}

TapChanger <|-- RatioTapChanger

RatioTapChanger "+RatioTapChanger 0..1" --> "+TransformerEnd 0..1" TransformerEnd

' RegulatingCondEq inherits from EnergyConnection
abstract class RegulatingCondEq  <<abstract>> {
   +controlEnabled: Boolean [0..1]
}

EnergyConnection <|-- RegulatingCondEq

RegulatingCondEq "+RegulatingCondEq 0..*" --> "+EquipmentController 0..1" EquipmentController
RegulatingCondEq "+RegulatingCondEq 0..*" --> "+RegulatingControl 0..1" RegulatingControl

' RegulatingControl inherits from EquipmentController
abstract class RegulatingControl  <<abstract>> {
   +ctPhase: PhaseCode [0..1]
   +ctRatio: Float [0..1]
   +discrete: Boolean [0..1]
   +enabled: Boolean [0..1]
   +maxAllowedTargetValue: Float [0..1]
   +minAllowedTargetValue: Float [0..1]
   +mode: RegulatingControlModeKind [0..1]
   +monitoredPhase: PhaseCode [0..1]
   +ptPhase: PhaseCode [0..1]
   +ptRatio: Float [0..1]
   +reverseTargetDeadband: Float [0..1]
   +reverseTargetValue: Float [0..1]
   +targetDeadband: Float [0..1]
   +targetValue: Float [0..1]
   +targetValueUnitMultiplier: UnitMultiplier [0..1]
}

EquipmentController <|-- RegulatingControl

RegulatingControl "+RegulatingControl 0..*" --> "+Terminal 0..1" Terminal : <<ShadowExtension>>

enum RegulatingControlModeKind <<enumeration>><<Attribute>>  {
   activePower
   admittance
   currentFlow
   powerFactor
   reactivePower
   temperature
   timeScheduled
   voltage
}

' ShuntCompensator inherits from RegulatingCondEq
abstract class ShuntCompensator <<ShadowExtension>> <<abstract>> {
   +aVRDelay: Seconds [0..1]
   +voltageSensitivity: VoltagePerReactivePower [0..1]
}

RegulatingCondEq <|-- ShuntCompensator


' TapChanger inherits from PowerSystemResource
abstract class TapChanger <<ShadowExtension>><<gmdm>> <<abstract>> {
   +controlEnabled: Boolean [0..1]
   +ctRating: Float [0..1]
   +ctRatio: Float [0..1]
   +highStep: Integer [0..1]
   +initialDelay: Seconds [0..1]
   +lowStep: Integer [0..1]
   +ltcFlag: Boolean [0..1]
   +neutralStep: Integer [0..1]
   +neutralU: Voltage [0..1]
   +normalStep: Integer [0..1]
   +ptPhase: PhaseCode [0..1]
   +ptRatio: Float [0..1]
   +step: Float [0..1]
   +subsequentDelay: Seconds [0..1]
}

PowerSystemResource <|-- TapChanger

TapChanger "+TapChanger 0..*" --> "+TapChangerControl 0..1" TapChangerControl

' TapChangerControl inherits from RegulatingControl
class TapChangerControl   {
   +lineDropCompensation: Boolean [0..1]
   +lineDropR: Resistance [0..1]
   +lineDropX: Reactance [0..1]
   +maxLimitVoltage: Voltage [0..1]
   +minLimitVoltage: Voltage [0..1]
   +reverseLineDropR: Resistance [0..1]
   +reverseLineDropX: Reactance [0..1]
   +reverseToNeutral: Boolean [0..1]
   +reversible: Boolean [0..1]
   +reversingDelay: Seconds [0..1]
   +reversingPowerThreshold: ActivePower [0..1]
}

RegulatingControl <|-- TapChangerControl


' Terminal inherits from ACDCTerminal
class Terminal <<ShadowExtension>><<Description>>  {
}

ACDCTerminal <|-- Terminal


' TransformerEnd inherits from PowerSystemResource
abstract class TransformerEnd  <<abstract>> {
}

PowerSystemResource <|-- TransformerEnd


' TransformerPhaseEnd inherits from TransformerEnd
class TransformerPhaseEnd <<GridAPPSD>><<Description>>  {
}

TransformerEnd <|-- TransformerPhaseEnd


enum UnitMultiplier <<enumeration>><<Attribute>>  {
   E
   G
   M
   P
   T
   Y
   Z
   a
   c
   d
   da
   f
   h
   k
   m
   micro
   n
   none
   p
   y
   [Remaining 1 literals hidden]
}

@enduml
