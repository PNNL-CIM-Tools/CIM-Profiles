class VsCapabilityCurve   {
   +referenceVoltage: Voltage [0..1]
}

IdentifiedObject <|-- VsCapabilityCurve

VsCapabilityCurve "+CapabilityCurve 0..*" --> "+VsConverter 0..1" VsConverter

' VsConverter inherits from ACDCConverter
class VsConverter <<NC>>  {
   +delta: AngleDegrees [0..1]
   +droop: PU [0..1]
   +droopCompensation: Resistance [0..1]
   +maxModulationIndex: Float [0..1]
   +maxValveCurrent: CurrentFlow [0..1]
   +pPccControl: VsPpccControlKind [0..1]
   +qPccControl: VsQpccControlKind [0..1]
   +qShare: PerCent [0..1]
   +targetPhasePcc: AngleDegrees [0..1]
   +targetPowerFactorPcc: Float [0..1]
   +targetPWMfactor: Float [0..1]
   +targetQpcc: ReactivePower [0..1]
   +targetUpcc: Voltage [0..1]
   +uv: Voltage [0..1]
}

ACDCConverter <|-- VsConverter

VsConverter "+VsConverter 0..1" --> "+VSCDynamics 0..1" VSCDynamics
VsConverter "+VsConverter 0..1" --> "+VsConverterRegularSchedule 0..*" VsConverterRegularSchedule : <<NC>>

' VsConverterRegularSchedule inherits from IdentifiedObject
class VsConverterRegularSchedule <<NC>>  {
}

IdentifiedObject <|-- VsConverterRegularSchedule

VsConverterRegularSchedule "+VsConverterRegularSchedule 0..*" --> "+VsConverter 0..1" VsConverter : <<NC>>

' VsConverterSchedule inherits from IdentifiedObject
class VsConverterSchedule <<OfAggregate>><<NC>>  {
}

IdentifiedObject <|-- VsConverterSchedule

VsConverterSchedule "+VsConverterSchedule 0..*" --> "+VsConverter 0..1" VsConverter : <<NC>>

' VsConverterTimePoint
class VsConverterTimePoint <<NC>>  {
}

VsConverterTimePoint "+VsConverterTimePoint 0..*" --o "+VsConverterSchedule 1" VsConverterSchedule : <<NC>>

enum VsPpccControlKind <<enumeration>><<Attribute>>  {
   pPcc
   pPccAndUdcDroop
   pPccAndUdcDroopPilot
   pPccAndUdcDroopWithCompensation
   phasePcc
   udc
}

enum VsQpccControlKind <<enumeration>><<Attribute>>  {
   powerFactorPcc
   pulseWidthModulation
   reactivePcc
   voltagePcc
}

@enduml
