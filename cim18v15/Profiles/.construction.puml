top to bottom direction
hide empty methods

' Adjust the horizontal spacing for better spatial rendering (the PlantUML default is ~20)
skinparam nodesep 20
' Adjust the vertical spacing for better spatial rendering (the PlantUML default is ~30)
skinparam ranksep 30

skinparam BackgroundColor #FFFFFF
skinparam shadowing false
skinparam RoundCorner 5
skinparam BorderColor #454645
skinparam ArrowColor #454645
skinparam FontColor #000000

skinparam class {
  ' Document root element style definition
  BackgroundColor<<Document Root>> #D3FBFE
  FontColor<<Document Root>> #000000
  FontSize<<Document Root>> 18
  AttributeFontColor<<Document Root>> #000000
  AttributeFontSize<<Document Root>> 18
  StereotypeFontColor<<Document Root>> #000000
  StereotypeFontSize<<Document Root>> 14
  HeaderFontColor<<Document Root>> #000000
  
  ' Choice element style definition
  BackgroundColor<<Choice>> #E6E6FF
  FontColor<<Choice>> #000000
  AttributeFontColor<<Choice>> #000000
  StereotypeFontColor<<Choice>> #000000
  HeaderFontColor<<Choice>> #000000
  BorderColor<<Choice>> #454645
  BorderThickness<<Choice>> 1
  
  ' Ref element style definition
  BackgroundColor<<Ref>> #FFDBDB
  FontColor<<Ref>> #000000
  AttributeFontColor<<Ref>> #000000
  StereotypeFontColor<<Ref>> #000000
  HeaderFontColor<<Ref>> #000000
  BorderColor<<Ref>> #454645
  BorderThickness<<Ref>> 1
  
  ' Concrete classes style definition
  BackgroundColor #FFFFE0
  FontColor #000000
  AttributeFontColor #000000
  StereotypeFontColor #000000
  HeaderFontColor #000000
  BorderColor #454645
  BorderThickness 1
  
  ' Abstract classes style definition
  BackgroundColor<<abstract>> #E8E8E8
  FontColor<<abstract>> #000000
  AttributeFontColor<<abstract>> #000000
  StereotypeFontColor<<abstract>> #000000
  HeaderFontColor<<abstract>> #000000
  BorderColor<<abstract>> #454645
  BorderThickness<<abstract>> 1
  
  ' Enumerations style definition
  BackgroundColor<<enumeration>> #A9F1A9
  FontColor<<enumeration>> #000000
  AttributeFontColor<<enumeration>> #000000
  StereotypeFontColor<<enumeration>> #000000
  HeaderFontColor <<enumeration>> #000000
  BorderColor<<enumeration>> #454645
  BorderThickness<<enumeration>> 1
  
  ' CIMDatatypes style definition
  BackgroundColor<<CIMDatatype>> #FFEBCD
  FontColor<<CIMDatatype>> #000000
  AttributeFontColor<<CIMDatatype>> #000000
  StereotypeFontColor<<CIMDatatype>> #000000
  HeaderFontColor<<CIMDatatype>> #000000
  BorderColor<<CIMDatatype>> #454645
  BorderThickness<<CIMDatatype>> 1
  
  ' Compound classes style definition
  BackgroundColor<<Compound>> #FFEBCD
  FontColor<<Compound>> #000000
  AttributeFontColor<<Compound>> #000000
  StereotypeFontColor<<Compound>> #000000
  HeaderFontColor<<Compound>> #000000
  BorderColor<<Compound>> #454645
  BorderThickness<<Compound>> 1
  
  ' Primitive classes style definition
  BackgroundColor<<Primitive>> #E6E6FF
  FontColor<<Primitive>> #000000
  AttributeFontColor<<Primitive>> #000000
  StereotypeFontColor<<Primitive>> #000000
  HeaderFontColor<<Primitive>> #000000
  BorderColor<<Primitive>> #454645
  BorderThickness<<Primitive>> 1
  
  ' Errors classes style definition
  BackgroundColor<<error>> #FFC0CB
  FontColor<<error>> #000000
  AttributeFontColor<<error>> #000000
  StereotypeFontColor<<error>> #000000
  HeaderFontColor<<error>> #000000
  BorderColor<<error>> #454645
  BorderThickness<<error>> 1
  
  ' Shadow classes style definition
  BackgroundColor<<ShadowExtension>> #C0C0C0
  FontColor<<ShadowExtension>> #000000
  AttributeFontColor<<ShadowExtension>> #000000
  StereotypeFontColor<<ShadowExtension>> #000000
  HeaderFontColor<<ShadowExtension>> #000000
  BorderColor<<ShadowExtension>> #454645
  BorderThickness<<ShadowExtension>> 1
  
}

skinparam shadowing true

hide <<Document Root>> stereotype
hide <<Choice>> stereotype
hide <<Ref>> stereotype
hide <<abstract>> stereotype
hide <<error>> stereotype


skinparam note {
   BorderColor #454645
   BorderThickness 1
   FontSize 14
   Font Bold
   FontColor #000000
}

' Add a note towards the upper left corner of the diagram
note as constructionNote #lightyellow
   Profile: construction
   Namespace: http://www.gridappsd.org/vfm/#
end note

' ACLineSegment inherits from Conductor
class ACLineSegment <<Description>><<ShadowExtension>>  {
   +circuitNumber: Integer [0..1]
   +spacingYOffset: Displacement [0..1]
}

Conductor <|-- ACLineSegment

ACLineSegment "+ACLineSegements 0..*" --> "+WireConfiguration 0..1" WireConfiguration : <<GridAPPSD>>
ACLineSegment "+ACLineSegment 0..*" --> "+WireSpacing 0..1" WireSpacing

enum BundleConfigurationKind <<enumeration>>  {
   symmetrical
   trefoil
   trefoilWithNeutral
}

' BundlePosition inherits from ConductorPosition
class BundlePosition   {
}

ConductorPosition <|-- BundlePosition


' BundledWireSpacing inherits from WireSpacing
class BundledWireSpacing <<GridAPPSD>>  {
}

WireSpacing <|-- BundledWireSpacing


' ConductingEquipment inherits from Equipment
abstract class ConductingEquipment <<ShadowExtension>> <<abstract>> {
}

Equipment <|-- ConductingEquipment


' Conductor inherits from ConductingEquipment
abstract class Conductor  <<abstract>> {
}

ConductingEquipment <|-- Conductor


' ConductorDistance inherits from IdentifiedObject
class ConductorDistance <<ShadowExtension>><<GridAPPSD>>  {
   +conductorKind1: ConductorPositionKind [0..1]
   +conductorKind2: ConductorPositionKind [0..1]
   +distance: Displacement [0..1]
   +<<ShadowExtension>> fromPhase: SinglePhaseKind [0..1]
   +fromSequenceNumber: Integer [0..1]
   +sequenceNumber1: Integer [0..1]
   +sequenceNumber2: Integer [0..1]
   +<<ShadowExtension>> toPhase: SinglePhaseKind [0..1]
   +toSequenceNumber: Integer [0..1]
}

IdentifiedObject <|-- ConductorDistance

ConductorDistance "+ConductorDistance 0..*" --> "+ConductorDistanceSpacing 0..1" ConductorDistanceSpacing

' ConductorDistanceSpacing inherits from WireSpacing
class ConductorDistanceSpacing <<GridAPPSD>>  {
}

WireSpacing <|-- ConductorDistanceSpacing


' ConductorPosition inherits from SpacingPosition
abstract class ConductorPosition <<MCT>> <<abstract>> {
   +circuitNumber: Integer [0..1]
   +kind: ConductorPositionKind [0..1]
   +sequenceNumber: Integer [0..1]
}

SpacingPosition <|-- ConductorPosition


enum ConductorPositionKind <<enumeration>><<Attribute>>  {
   earth
   mixed
   neutral
   phase
   shield
}

enum CoreConstructionKind <<GridAPPSD>><<enumeration>><<Attribute>>  {
   coreForm
   shellForm
}

enum EarthModelKind <<GridAPPSD>><<enumeration>><<Attribute>>  {
   carson
   deri
}

' EarthResistivity inherits from IdentifiedObject
class EarthResistivity <<GridAPPSD>><<Description>>  {
   +<<GridAPPSD>> earthModelType: EarthModelKind [0..1]
   +earthReturnGMR: Length [0..1]
   +rho: Resistance [0..1]
}

IdentifiedObject <|-- EarthResistivity


' Equipment inherits from PowerSystemResource
abstract class Equipment  <<abstract>> {
}

PowerSystemResource <|-- Equipment


' IdentifiedObject
abstract class IdentifiedObject  <<abstract>> {
   +mRID: String [0..1]
   +aliasName: String [0..1]
   +description: String [0..1]
   +name: String [0..1]
}


' MagneticCore inherits from IdentifiedObject
abstract class MagneticCore <<new>><<GridAPPSD>> <<abstract>> {
}

IdentifiedObject <|-- MagneticCore


' MultiCircuitGroup
class MultiCircuitGroup <<new>><<GridAPPSD>>  {
}

MultiCircuitGroup "+MultiCircuitGroup 0..1" --> "+XYSpacing 0..1" XYSpacing

' MulticoreCablePosition inherits from ConductorPosition
class MulticoreCablePosition   {
}

ConductorPosition <|-- MulticoreCablePosition


' PerLengthImpedance inherits from PerLengthLineParameter
abstract class PerLengthImpedance <<ShadowExtension>><<GridAPPSD>> <<abstract>> {
}

PerLengthLineParameter <|-- PerLengthImpedance


' PerLengthLineParameter inherits from IdentifiedObject
abstract class PerLengthLineParameter <<ShadowExtension>> <<abstract>> {
}

IdentifiedObject <|-- PerLengthLineParameter


' PerLengthPhaseImpedance inherits from PerLengthImpedance
class PerLengthPhaseImpedance <<Description>>  {
}

PerLengthImpedance <|-- PerLengthPhaseImpedance


' PerLengthSequenceImpedance inherits from PerLengthImpedance
class PerLengthSequenceImpedance <<Description>>  {
}

PerLengthImpedance <|-- PerLengthSequenceImpedance


enum PhaseShuntConnectionKind <<ShadowExtension>><<GridAPPSD>><<enumeration>><<Attribute>>  {
   D
   G
   I
   Y
   Yn
}

' PowerSystemResource inherits from IdentifiedObject
abstract class PowerSystemResource <<ShadowExtension>> <<abstract>> {
}

IdentifiedObject <|-- PowerSystemResource


' PowerTransformer inherits from ConductingEquipment
class PowerTransformer <<ShadowExtension>><<Description>>  {
}

ConductingEquipment <|-- PowerTransformer


' PowerTransformerEnd inherits from TransformerEnd
class PowerTransformerEnd <<ShadowExtension>><<Description>>  {
}

TransformerEnd <|-- PowerTransformerEnd


enum SinglePhaseKind <<ShadowExtension>><<enumeration>><<Attribute>>  {
   A
   B
   C
   E
   N
   X
   Y
   s1
   s2
}

' SpacingPosition inherits from IdentifiedObject
abstract class SpacingPosition <<MCT>> <<abstract>> {
   +xCoord: Displacement [0..1]
   +yCoord: Displacement [0..1]
}

IdentifiedObject <|-- SpacingPosition


' TransformerCore inherits from MagneticCore
class TransformerCore <<new>><<GridAPPSD>>  {
   +form: CoreConstructionKind [0..1]
}

MagneticCore <|-- TransformerCore

TransformerCore "+TransformerCore 0..1" --> "+TransformerTank 0..1" TransformerTank : <<ShadowExtension>>

' TransformerEnd inherits from PowerSystemResource
abstract class TransformerEnd <<ShadowExtension>><<OfAggregate>><<GridAPPSD>> <<abstract>> {
}

PowerSystemResource <|-- TransformerEnd


' TransformerLug inherits from IdentifiedObject
class TransformerLug <<GridAPPSD>><<new>>  {
   +designation: String [0..1]
}

IdentifiedObject <|-- TransformerLug

TransformerLug "+AutoTransformerLug 0..1" --> "+AutoTransformerWinding 0..1" TransformerWinding : <<new>>
TransformerLug "+FromTransformerLug 0..1" --> "+FromTransformerWinding 0..1" TransformerWinding : <<new>>
TransformerLug "+ToTransformerLug 0..1" --> "+ToTransformerWinding 0..1" TransformerWinding : <<new>>
TransformerLug "+TransformerLugs 0..*" --o "+TransformerEnd 0..1" TransformerEnd
TransformerLug "+TransformerLug 0..*" --> "+TransformerTank 0..1" TransformerTank : <<ShadowExtension>>

' TransformerPhaseEnd inherits from TransformerEnd
class TransformerPhaseEnd <<GridAPPSD>><<Description>>  {
}

TransformerEnd <|-- TransformerPhaseEnd


' TransformerTank inherits from Equipment
class TransformerTank <<ShadowExtension>>  {
}

Equipment <|-- TransformerTank

TransformerTank "+TransformerTanks 0..*" --> "+PowerTransformer 0..1" PowerTransformer : <<ShadowExtension>>

' TransformerWinding inherits from IdentifiedObject
class TransformerWinding <<GridAPPSD>><<new>>  {
   +connection: PhaseShuntConnectionKind [0..1]
}

IdentifiedObject <|-- TransformerWinding

TransformerWinding "+AutoTransformerWinding 0..1" --> "+AutoTransformerLug 0..1" TransformerLug : <<new>>
TransformerWinding "+FromTransformerWinding 0..*" --> "+FromTransformerEnd 0..1" TransformerEnd
TransformerWinding "+ToTransformerWinding 0..*" --> "+ToTransformerEnd 0..1" TransformerEnd
TransformerWinding "+ToTransformerWinding 0..1" --> "+ToTransformerLug 0..1" TransformerLug : <<new>>
TransformerWinding "+TransformerWindings 0..*" --> "+TransformerCore 0..1" TransformerCore : <<new>>
TransformerWinding "+TransformerWindings 0..*" --> "+TransformerTank 0..1" TransformerTank : <<ShadowExtension>>

' WireConfiguration inherits from IdentifiedObject
class WireConfiguration <<GridAPPSD>>  {
   +<<GridAPPSD>> installationType: WireInstallationKind [0..1]
   +numberOfPhases: Integer [0..1]
   +usage: WireUsageKind [0..1]
}

IdentifiedObject <|-- WireConfiguration

WireConfiguration "+WireAssemblies 0..*" --> "+EarthResistivity 0..1" EarthResistivity : <<GridAPPSD>>
WireConfiguration "+WireAssembly 0..1" --> "+PerLengthImpedance 0..1" PerLengthImpedance
WireConfiguration "+WireConfiguration 0..*" --> "+WireSpacing 0..1" WireSpacing

enum WireInstallationKind <<GridAPPSD>><<enumeration>>  {
   overheadBare
   overheadSpacerCable
   overheadTreeWire
   undergroundConduit
   undergroundDirectBury
   undergroundDuctBank
}

' WireSpacing inherits from IdentifiedObject
abstract class WireSpacing <<MCT>> <<abstract>> {
}

IdentifiedObject <|-- WireSpacing


enum WireUsageKind <<enumeration>>  {
   distribution
   other
   secondary
   transmission
}

' XYSpacing inherits from WireSpacing
class XYSpacing <<MCT>>  {
}

WireSpacing <|-- XYSpacing


@enduml
