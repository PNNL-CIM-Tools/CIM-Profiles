top to bottom direction
hide empty methods

' Adjust the horizontal spacing for better spatial rendering (the PlantUML default is ~20)
skinparam nodesep 20
' Adjust the vertical spacing for better spatial rendering (the PlantUML default is ~30)
skinparam ranksep 30

skinparam BackgroundColor #FFFFFF
skinparam shadowing false
skinparam RoundCorner 5
skinparam BorderColor #454645
skinparam ArrowColor #454645
skinparam FontColor #000000

skinparam class {
  ' Document root element style definition
  BackgroundColor<<Document Root>> #D3FBFE
  FontColor<<Document Root>> #000000
  FontSize<<Document Root>> 18
  AttributeFontColor<<Document Root>> #000000
  AttributeFontSize<<Document Root>> 18
  StereotypeFontColor<<Document Root>> #000000
  StereotypeFontSize<<Document Root>> 14
  HeaderFontColor<<Document Root>> #000000
  
  ' Choice element style definition
  BackgroundColor<<Choice>> #E6E6FF
  FontColor<<Choice>> #000000
  AttributeFontColor<<Choice>> #000000
  StereotypeFontColor<<Choice>> #000000
  HeaderFontColor<<Choice>> #000000
  BorderColor<<Choice>> #454645
  BorderThickness<<Choice>> 1
  
  ' Ref element style definition
  BackgroundColor<<Ref>> #FFDBDB
  FontColor<<Ref>> #000000
  AttributeFontColor<<Ref>> #000000
  StereotypeFontColor<<Ref>> #000000
  HeaderFontColor<<Ref>> #000000
  BorderColor<<Ref>> #454645
  BorderThickness<<Ref>> 1
  
  ' Concrete classes style definition
  BackgroundColor #FFFFE0
  FontColor #000000
  AttributeFontColor #000000
  StereotypeFontColor #000000
  HeaderFontColor #000000
  BorderColor #454645
  BorderThickness 1
  
  ' Abstract classes style definition
  BackgroundColor<<abstract>> #E8E8E8
  FontColor<<abstract>> #000000
  AttributeFontColor<<abstract>> #000000
  StereotypeFontColor<<abstract>> #000000
  HeaderFontColor<<abstract>> #000000
  BorderColor<<abstract>> #454645
  BorderThickness<<abstract>> 1
  
  ' Enumerations style definition
  BackgroundColor<<enumeration>> #A9F1A9
  FontColor<<enumeration>> #000000
  AttributeFontColor<<enumeration>> #000000
  StereotypeFontColor<<enumeration>> #000000
  HeaderFontColor <<enumeration>> #000000
  BorderColor<<enumeration>> #454645
  BorderThickness<<enumeration>> 1
  
  ' CIMDatatypes style definition
  BackgroundColor<<CIMDatatype>> #FFEBCD
  FontColor<<CIMDatatype>> #000000
  AttributeFontColor<<CIMDatatype>> #000000
  StereotypeFontColor<<CIMDatatype>> #000000
  HeaderFontColor<<CIMDatatype>> #000000
  BorderColor<<CIMDatatype>> #454645
  BorderThickness<<CIMDatatype>> 1
  
  ' Compound classes style definition
  BackgroundColor<<Compound>> #FFEBCD
  FontColor<<Compound>> #000000
  AttributeFontColor<<Compound>> #000000
  StereotypeFontColor<<Compound>> #000000
  HeaderFontColor<<Compound>> #000000
  BorderColor<<Compound>> #454645
  BorderThickness<<Compound>> 1
  
  ' Primitive classes style definition
  BackgroundColor<<Primitive>> #E6E6FF
  FontColor<<Primitive>> #000000
  AttributeFontColor<<Primitive>> #000000
  StereotypeFontColor<<Primitive>> #000000
  HeaderFontColor<<Primitive>> #000000
  BorderColor<<Primitive>> #454645
  BorderThickness<<Primitive>> 1
  
  ' Errors classes style definition
  BackgroundColor<<error>> #FFC0CB
  FontColor<<error>> #000000
  AttributeFontColor<<error>> #000000
  StereotypeFontColor<<error>> #000000
  HeaderFontColor<<error>> #000000
  BorderColor<<error>> #454645
  BorderThickness<<error>> 1
  
  ' Shadow classes style definition
  BackgroundColor<<ShadowExtension>> #C0C0C0
  FontColor<<ShadowExtension>> #000000
  AttributeFontColor<<ShadowExtension>> #000000
  StereotypeFontColor<<ShadowExtension>> #000000
  HeaderFontColor<<ShadowExtension>> #000000
  BorderColor<<ShadowExtension>> #454645
  BorderThickness<<ShadowExtension>> 1
  
}

skinparam shadowing true

hide <<Document Root>> stereotype
hide <<Choice>> stereotype
hide <<Ref>> stereotype
hide <<abstract>> stereotype
hide <<error>> stereotype


skinparam note {
   BorderColor #454645
   BorderThickness 1
   FontSize 14
   Font Bold
   FontColor #000000
}

' Add a note towards the upper left corner of the diagram
note as tier5_substationNote #lightyellow
   Profile: tier5_substation
   Namespace: http://www.gridappsd.org/vfm#
end note

' ACDCTerminal inherits from IdentifiedObject
abstract class ACDCTerminal  <<abstract>> {
   +connected: Boolean [0..1]
   +sequenceNumber: Integer [0..1]
}

IdentifiedObject <|-- ACDCTerminal

ACDCTerminal "+Terminal 0..*" --> "+BusNameMarker 0..1" BusNameMarker

' BaseVoltage inherits from IdentifiedObject
class BaseVoltage <<ShadowExtension>>  {
}

IdentifiedObject <|-- BaseVoltage


' Bay inherits from EquipmentContainer
class Bay   {
   +breakerConfiguration: BreakerConfiguration [0..1]
   +busBarConfiguration: BusbarConfiguration [0..1]
}

EquipmentContainer <|-- Bay

Bay "+Bays 0..*" --o "+Substation 0..1" Substation
Bay "+Bays 0..*" --o "+VoltageLevel 0..1" VoltageLevel

' Breaker inherits from ProtectedSwitch
class Breaker   {
}

ProtectedSwitch <|-- Breaker


enum BreakerConfiguration <<enumeration>><<Attribute>>  {
   breakerAndAHalf
   doubleBreaker
   noBreaker
   singleBreaker
}

' BusNameMarker inherits from IdentifiedObject
class BusNameMarker   {
   +priority: Integer [0..1]
}

IdentifiedObject <|-- BusNameMarker


' BusSegment inherits from Conductor
class BusSegment   {
}

Conductor <|-- BusSegment


enum BusbarConfiguration <<enumeration>><<Attribute>>  {
   doubleBus
   mainWithTransfer
   ringBus
   singleBus
}

' BusbarSection inherits from Connector
class BusbarSection   {
   +ipMax: CurrentFlow [0..1]
}

Connector <|-- BusbarSection


' ConductingEquipment inherits from Equipment
abstract class ConductingEquipment <<ShadowExtension>> <<abstract>> {
}

Equipment <|-- ConductingEquipment


' Conductor inherits from ConductingEquipment
abstract class Conductor  <<abstract>> {
}

ConductingEquipment <|-- Conductor


' ConnectivityNode inherits from IdentifiedObject
class ConnectivityNode <<ShadowExtension>>  {
}

IdentifiedObject <|-- ConnectivityNode


' ConnectivityNodeContainer inherits from PowerSystemResource
abstract class ConnectivityNodeContainer  <<abstract>> {
}

PowerSystemResource <|-- ConnectivityNodeContainer


' Connector inherits from ConductingEquipment
abstract class Connector  <<abstract>> {
}

ConductingEquipment <|-- Connector


' DisconnectingCircuitBreaker inherits from Breaker
class DisconnectingCircuitBreaker   {
}

Breaker <|-- DisconnectingCircuitBreaker


' Disconnector inherits from Switch
class Disconnector   {
}

Switch <|-- Disconnector


' EarthingSwitch inherits from Switch
class EarthingSwitch   {
}

Switch <|-- EarthingSwitch


' Equipment inherits from PowerSystemResource
abstract class Equipment  <<abstract>> {
   +aggregate: Boolean [0..1]
}

PowerSystemResource <|-- Equipment

Equipment "+Equipments 0..*" --> "+EquipmentContainer 0..1" EquipmentContainer

' EquipmentContainer inherits from ConnectivityNodeContainer
abstract class EquipmentContainer  <<abstract>> {
}

ConnectivityNodeContainer <|-- EquipmentContainer


' Feeder inherits from EquipmentContainer
class Feeder <<OfAggregate>>  {
}

EquipmentContainer <|-- Feeder


' GeographicalRegion inherits from IdentifiedObject
class GeographicalRegion <<OfAggregate>>  {
}

IdentifiedObject <|-- GeographicalRegion


' Ground inherits from ConductingEquipment
class Ground   {
}

ConductingEquipment <|-- Ground


' GroundDisconnector inherits from Switch
class GroundDisconnector <<deprecated>>  {
}

Switch <|-- GroundDisconnector


' IdentifiedObject
abstract class IdentifiedObject  <<abstract>> {
   +mRID: String [0..1]
   +description: String [0..1]
   +name: String [0..1]
}


' Junction inherits from Connector
class Junction   {
}

Connector <|-- Junction


' Line inherits from EquipmentContainer
class Line   {
}

EquipmentContainer <|-- Line

Line "+Lines 0..*" --o "+Region 0..1" SubGeographicalRegion

' PowerSystemResource inherits from IdentifiedObject
abstract class PowerSystemResource <<ShadowExtension>> <<abstract>> {
}

IdentifiedObject <|-- PowerSystemResource


' ProtectedSwitch inherits from Switch
abstract class ProtectedSwitch  <<abstract>> {
}

Switch <|-- ProtectedSwitch


' SubGeographicalRegion inherits from IdentifiedObject
class SubGeographicalRegion <<OfAggregate>>  {
}

IdentifiedObject <|-- SubGeographicalRegion

SubGeographicalRegion "+Regions 0..*" --o "+Region 0..1" GeographicalRegion

' Substation inherits from EquipmentContainer
class Substation <<OfAggregate>>  {
}

EquipmentContainer <|-- Substation

Substation "+NamingSecondarySubstation 0..*" --o "+NamingFeeder 0..1" Feeder
Substation "+NormalEnergizedSubstation 0..*" --> "+NormalEnergizingFeeder 0..*" Feeder
Substation "+Substations 0..*" --o "+Region 0..1" SubGeographicalRegion

' Switch inherits from ConductingEquipment
abstract class Switch <<ShadowExtension>> <<abstract>> {
}

ConductingEquipment <|-- Switch


' Terminal inherits from ACDCTerminal
class Terminal <<ShadowExtension>>  {
}

ACDCTerminal <|-- Terminal

Terminal "+Terminals 0..*" --> "+ConductingEquipment 1" ConductingEquipment : <<ShadowExtension>>
Terminal "+Terminals 0..*" --> "+ConnectivityNode 0..1" ConnectivityNode : <<ShadowExtension>>

' VoltageLevel inherits from EquipmentContainer
class VoltageLevel <<OfAggregate>>  {
   +highVoltageLimit: Voltage [0..1]
   +lowVoltageLimit: Voltage [0..1]
}

EquipmentContainer <|-- VoltageLevel

VoltageLevel "+VoltageLevel 0..*" --> "+BaseVoltage 1" BaseVoltage : <<ShadowExtension>>
VoltageLevel "+VoltageLevels 0..*" --o "+Substation 1" Substation

@enduml
