{
  "@context": {
    "cim": "http://cim.ucaiug.io/cim101/draft#",
    "dcat": "http://www.w3.org/ns/dcat#",
    "dct": "http://purl.org/dc/terms/",
    "md": "http://iec.ch/TC57/61970-552/ModelDescription/1#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dct:conformsTo": {
      "@type": "@id"
    },
    "dct:issued": {
      "@type": "xsd:dateTime"
    },
    "dct:references": {
      "@type": "@id"
    },
    "dct:requires": {
      "@type": "@id"
    },
    "dct:replaces": {
      "@type": "@id"
    },
    "dcat:isVersionOf": {
      "@type": "@id"
    },
    "dcat:startDate": {
      "@type": "xsd:dateTimeStamp"
    },
    "dcat:endDate": {
      "@type": "xsd:dateTimeStamp"
    },
    "prov:atLocation": {
      "@type": "@id"
    },
    "prov:generatedAtTime": {
      "@type": "xsd:dateTime"
    },
    "prov:invalidatedAtTime": {
      "@type": "xsd:dateTime"
    },
    "cim:IdentifiedObject.ObjectType": {
      "@type": "@id"
    },
    "cim:Name.NameType": {
      "@type": "@id"
    },
    "cim:NameType.NamingAuthority": {
      "@type": "@id"
    },
    "cim:ObjectIdentificationRevision.IdentifiedObjectRevision": {
      "@type": "@id"
    },
    "cim:ObjectIdentificationRevision.ObjectIdentificationRevisionSet": {
      "@type": "@id"
    },
    "cim:ObjectIdentificationRevision.revisionKind": {
      "@type": "@id"
    },
    "cim:ObjectIdentificationRevisionSet.Object": {
      "@type": "@id"
    },
    "cim:ObjectIdentificationRevisionSet.effectiveDateTime": {
      "@type": "xsd:dateTime"
    }
  }
}
